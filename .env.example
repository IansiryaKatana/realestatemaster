# Deploy edge functions after migrations:
# - subscribe-newsletter
# - request-quote
# - create-checkout-session
# - create-property-checkout-session
# - verify-checkout-session
# - stripe-webhook
# - admin-stripe-config
#
# Stripe webhook URL: {SUPABASE_URL}/functions/v1/stripe-webhook
#
# Quote emails (Supabase project secrets, not in this file):
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Astor Electronics <sales@yourdomain.com>
#
# WhatsApp Cloud API (Supabase Edge Function secrets — set in Dashboard → Edge Functions → Secrets)
# One agency WhatsApp Business line sends all automated messages. Each agent's mobile is the recipient.
#
# WHATSAPP_ACCESS_TOKEN=...           # Meta Graph API token (agency Business account)
# WHATSAPP_PHONE_NUMBER_ID=...        # Sender: your company's registered WhatsApp Business number
# WHATSAPP_TEMPLATE_LANGUAGE=en       # Optional, default en
#
# Approved message templates (required for automated texts to clients in production):
# WHATSAPP_TEMPLATE_AGENT_ALERT=agent_new_lead
#   Body example: New lead {{1}} for {{2}}. Phone: {{3}}
# WHATSAPP_TEMPLATE_VIEWING_CONFIRMED=viewing_confirmed
#   Body example: Hi {{1}}, your viewing for {{2}} ({{3}}) is confirmed on {{4}} ({{5}}).
# WHATSAPP_TEMPLATE_VIEWING_DECLINED=viewing_declined
#   Body example: Hi {{1}}, we could not confirm your viewing for {{2}} ({{3}}). Please contact us to reschedule.
#
# Per-agent numbers: Admin → Real Estate → Agents → "WhatsApp number" (also used on property pages via wa.me).
# If WhatsApp is empty, voice phone is used for agent alerts.
