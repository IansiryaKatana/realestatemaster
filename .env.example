# Copy to `.env` for local development. Set the same VITE_* keys in your host dashboard for production builds.

# =============================================================================
# Frontend (Vite — exposed to the browser; use publishable/anon key only)
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# =============================================================================
# Local CLI & seed scripts (never commit real values; never use VITE_ prefix)
# =============================================================================
# Database password for `supabase link` / `supabase db push` (Dashboard → Database)
SUPABASE_DB_PASSWORD=

# Service role key — required for `npm run seed:media` only (Dashboard → API → service_role)
# NEVER expose this in the frontend or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias used by some deploy scripts
# SUPABASE_URL=https://your-project-ref.supabase.co

# =============================================================================
# Node server (optional — Hostinger / custom Node deploy)
# =============================================================================
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# Build target (use npm scripts — do not set in host dashboards)
# DEPLOY_TARGET=node      → npm run build:hostinger
# DEPLOY_TARGET=netlify   → npm run build:netlify
# DEPLOY_TARGET=vercel    → npm run build:vercel

# =============================================================================
# Clean install (new Supabase project)
# =============================================================================
# 1. Copy this file to `.env` and fill Frontend + CLI keys above
# 2. supabase link --project-ref <your-ref>
# 3. supabase db push
# 4. npm run seed:media          ← uploads bundled images from supabase/seed-media/
# 5. Deploy edge functions (list below)
# 6. Set Supabase Edge Function secrets (list below)
# 7. Configure Stripe in Admin → Integrations (or private_settings)
# 8. Create first admin: sign up at /admin/login → insert into admin_users

# =============================================================================
# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# Auto-injected on deploy: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# =============================================================================

# --- Email (Resend) — quote, order, contact, test emails ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=GW Vacation Homes <hello@yourdomain.com>

# Public site URL for links in emails (no trailing slash)
SITE_URL=https://yourdomain.com
# STORE_URL=https://yourdomain.com

# --- WhatsApp Cloud API (optional — viewing alerts & agent notifications) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_AGENT_ALERT=agent_new_lead
WHATSAPP_TEMPLATE_VIEWING_CONFIRMED=viewing_confirmed
WHATSAPP_TEMPLATE_VIEWING_DECLINED=viewing_declined

# --- Stripe ---
# Secret key + webhook secret are stored in `private_settings` via Admin → Integrations.
# Webhook endpoint after deploy:
#   {SUPABASE_URL}/functions/v1/stripe-webhook
# Subscribe to: checkout.session.completed, checkout.session.expired,
#               payment_intent.succeeded, payment_intent.payment_failed

# =============================================================================
# Deploy edge functions (after migrations)
# =============================================================================
# supabase functions deploy subscribe-newsletter
# supabase functions deploy request-quote
# supabase functions deploy create-checkout-session
# supabase functions deploy create-property-checkout-session
# supabase functions deploy verify-checkout-session
# supabase functions deploy stripe-webhook
# supabase functions deploy admin-stripe-config
# supabase functions deploy submit-contact-form
# supabase functions deploy submit-property-inquiry
# supabase functions deploy submit-property-callback
# supabase functions deploy notify-viewing-status
# supabase functions deploy send-test-email
# supabase functions deploy mark-order-shipped
# supabase functions deploy process-abandoned-carts
